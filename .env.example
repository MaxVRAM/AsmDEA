# Example .env configuration for asmdef_analyse.py
# Copy this file to .env and customise the values

# Root path to search for .asmdef files (required if not provided as argument)
ROOT_PATH=D:/Development/ExampleProject

# Show detailed dependency trees for cycles (true/false)
DETAILED=true

# Maximum depth for dependency trees (integer)
DEPTH=3

# Output file path for the cycle report (optional)
OUTPUT_PATH=./reports/cycle_report.json

# Intermediate dictionary file name (optional)
DICT_FILE=./reports/asmdef_dictionary.json

# Analyse and list all .cs files for each assembly (true/false)
ANALYSE_FILES=true

# Allow child namespaces that extend the root namespace (default: true)
# e.g., Flaim.Systems.Contracts.Messaging is allowed under root namespace Flaim.Systems.Contracts
ALLOW_CHILD_NAMESPACES=true
