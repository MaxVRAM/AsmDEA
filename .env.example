# Example .env configuration for asmdef_cli.py
# Copy this file to .env and customize the values
# CLI arguments override these environment variables

# ==============================================================================
# Project Configuration
# ==============================================================================

# Root path to Unity project (Assets folder)
# Required for: analyze, validate-namespaces, map-files commands
ROOT_PATH=D:/Development/ExampleProject/Assets

# ==============================================================================
# Output Configuration
# ==============================================================================

# Output directory for all reports (default: ./reports)
OUTPUT_PATH=./reports

# Assembly dictionary file path (default: ./reports/asmdef_dictionary.json)
DICT_FILE=./reports/asmdef_dictionary.json

# ==============================================================================
# Analysis Options
# ==============================================================================

# Allow child namespaces that extend the root namespace (default: true)
# Example: Flaim.Systems.Contracts.Messaging is allowed under root namespace Flaim.Systems.Contracts
ALLOW_CHILD_NAMESPACES=true

# Include the list of mismatched file paths in namespace_report.json (true/false, default: true)
# Set to false to keep the JSON report compact (only counts/percentages will be emitted)
SHOW_UNMATCHED_PATHS=true

# ==============================================================================
# Cycle Detection Options
# ==============================================================================

# Show detailed dependency trees in cycle reports (true/false)
DETAILED=true

# Maximum depth for dependency tree visualization (integer, default: 2)
DEPTH=2

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ==============================================================================
# Usage Examples
# ==============================================================================
# Run complete analysis:
#   python asmdef_cli.py analyze --project-path $ROOT_PATH
#
# Detect cycles only:
#   python asmdef_cli.py detect-cycles --dict-file $DICT_FILE
#
# Validate namespaces:
#   python asmdef_cli.py validate-namespaces --project-path $ROOT_PATH
#
# See all options:
#   python asmdef_cli.py --help
#   python asmdef_cli.py analyze --help
