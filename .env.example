# Example .env configuration for asmdef_analyze.py
# Copy this file to .env and customize the values

# Root path to search for .asmdef files (required if not provided as argument)
ROOT_PATH=D:/Development/ExampleProject

# Show detailed dependency trees for cycles (true/false)
DETAILED=true

# Maximum depth for dependency trees (integer)
DEPTH=3

# Output file path for the cycle report (optional)
OUTPUT_PATH=./output/cycle_report.txt

# Intermediate dictionary file name (optional)
DICT_FILE=./.work/asmdef_dictionary.json

# Analyze and list all .cs files for each assembly (true/false)
ANALYZE_FILES=false
